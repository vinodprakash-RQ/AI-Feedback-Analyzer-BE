DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_feedback"
# Comma-separated third-party API keys. Use a secrets manager in production.
FEEDBACK_API_KEYS="replace-with-a-long-random-key"
# Google AI Studio/Gemini API key used by the asynchronous classifier.
GEMINI_API_KEY="replace-with-gemini-api-key"
# Set this to a Gemini model enabled for your Google AI account.
GEMINI_MODEL="gemini-2.5-flash"
# Format: api-key=project_id_1|project_id_2. Use * for all projects.
DASHBOARD_API_KEYS="replace-with-dashboard-key=*"
ANALYSIS_WORKER_INTERVAL_MS="5000"
ANALYSIS_WORKER_BATCH_SIZE="10"
