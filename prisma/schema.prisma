generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FeedbackCategory {
  APPLICATION_GENERATION
  AI_RESPONSE
  BUILD_FAILURE
  UI_UX
  AUTHENTICATION
  PERFORMANCE
  INTEGRATION
  PRODUCT_UI
  FEATURE_REQUEST
  PAYMENTS
  CUSTOMER_SUPPORT
  BUG_MOBILE
  USABILITY
  NOTIFICATIONS
  ONBOARDING
  SECURITY
  AVAILABILITY
  GENERAL
  OTHER
}

enum FeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  FRUSTRATED
  MIXED
}

enum FeedbackSource {
  IN_APP
  EMAIL
  SUPPORT_TICKET
  API
}

enum SubmissionStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum IssueStatus {
  NEW
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum AnalysisIntent {
  BUG_REPORT
  FEATURE_REQUEST
  QUESTION
  OTHER
}

enum AnalysisRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model FeedbackSubmission {
  id             String           @id @default(cuid())
  message        String
  userId         String?
  conversationId String?
  projectId      String?
  source         String?
  pageUrl        String?
  userAgent      String?
  metadata       Json?
  idempotencyKey String?
  idempotencyFingerprint String?
  apiClient      String
  status         SubmissionStatus @default(RECEIVED)
  issueStatus    IssueStatus      @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  analysisRuns   FeedbackAnalysisRun[]

  @@unique([apiClient, idempotencyKey])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([issueStatus, createdAt])
}

model FeedbackAnalysisRun {
  id            String           @id @default(cuid())
  feedbackId    String
  attempt       Int              @default(1)
  status        AnalysisRunStatus @default(PENDING)
  sentiment     FeedbackSentiment?
  intent        AnalysisIntent?
  category      FeedbackCategory?
  subcategory   String?
  severity      FeedbackSeverity?
  summary       String?
  confidence    Float?
  model         String?
  promptVersion String?
  errorCode     String?
  errorMessage  String?
  nextAttemptAt DateTime         @default(now())
  lockedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  feedback      FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, attempt])
  @@index([status, nextAttemptAt])
  @@index([feedbackId, status, createdAt])
  @@index([category, createdAt])
  @@index([sentiment, createdAt])
  @@index([severity, createdAt])
}

model Feedback {
  id          String           @id @default(cuid())
  title       String
  description String
  status      FeedbackStatus   @default(OPEN)
  severity    FeedbackSeverity @default(MEDIUM)
  category    FeedbackCategory @default(OTHER)
  sentiment   FeedbackSentiment @default(NEUTRAL)
  source      FeedbackSource   @default(IN_APP)
  reporterEmail String?
  assignee    String?
  tags        String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  @@index([status, severity])
  @@index([category, createdAt])
  @@index([sentiment, createdAt])
  @@index([createdAt])
}
